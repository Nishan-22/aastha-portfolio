{
  "name": "aastha-portfolio-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API backend for the Aastha Sharma portfolio site",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx src/scripts/migrate.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@vercel/blob": "^2.8.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongodb": "^7.5.0",
    "multer": "^2.2.0",
    "resend": "^6.20.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
