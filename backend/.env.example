# MongoDB Atlas connection string (required for deploy — content + contact messages)
MONGODB_URI=mongodb+srv://USER:DB_PASSWORD@cluster0.mongodb.net/?appName=Cluster0
# Database name (defaults to aastha_portfolio)
MONGODB_DB=aastha_portfolio

# Vercel Blob store token (required for admin file uploads)
BLOB_READ_WRITE_TOKEN=

# Admin panel password
ADMIN_PASSWORD=admin123

# Optional: email delivery for the contact form
RESEND_API_KEY=
RESEND_FROM_EMAIL=portfolio <onboarding@resend.dev>
RESEND_TO_EMAIL=

# Local dev only (Vercel ignores this)
PORT=4000